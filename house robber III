class Solution(object):
    def rob(self, root):
        """
        :type root: Optional[TreeNode]
        :rtype: int
        """

        def dfs(node):
            if not node:
                return (0, 0)

            left = dfs(node.left)
            right = dfs(node.right)

            # If we rob this node
            rob_node = node.val + left[1] + right[1]

            # If we don't rob this node
            skip_node = max(left) + max(right)

            return (rob_node, skip_node)

        return max(dfs(root))
