class NestedIterator(object):

    def __init__(self, nestedList):
        """
        :type nestedList: List[NestedInteger]
        """
        self.stack = list(reversed(nestedList))

    def next(self):
        """
        :rtype: int
        """
        self.hasNext()
        return self.stack.pop().getInteger()

    def hasNext(self):
        """
        :rtype: bool
        """
        while self.stack:
            top = self.stack[-1]

            if top.isInteger():
                return True

            self.stack.pop()
            self.stack.extend(reversed(top.getList()))

        return False
